      <aliases enabled='yes' />
      <column caption='Churn Flag' datatype='integer' name='[Calculation_1797209591844864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Churn]=&quot;Yes&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Total Customers' datatype='integer' name='[Calculation_1797209591939073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customerID])' />
      </column>
      <column caption='Churned Customers' datatype='integer' name='[Calculation_1797209592020994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1797209591844864])' />
      </column>
      <column caption='Retained Customers' datatype='integer' name='[Calculation_1797209592127491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1797209591939073] - [Calculation_1797209592020994]' />
      </column>
      <column caption='Churn Rate' datatype='real' default-format='p0.00%' name='[Calculation_1797209592205316]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1797209591844864]) / COUNTD([customerID])' />
      </column>
      <column caption='Revenue Lost' datatype='real' default-format='C1033%' name='[Calculation_1797209592299525]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Churn]=&quot;Yes&quot; THEN [MonthlyCharges] END)' />
      </column>
      <column caption='Revenue Lost %' datatype='real' default-format='p0.00%' name='[Calculation_1797209592381446]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1797209592299525] / SUM([MonthlyCharges])' />
      </column>
      <column caption='Senior Label' datatype='string' name='[Calculation_1797209592463367]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [SeniorCitizen]=1 THEN &quot;Senior&quot; ELSE &quot;Non-senior&quot; END' />
      </column>
      <column caption='Tenure Band' datatype='string' name='[Calculation_1797209592549384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tenure]&lt;=12 THEN &quot;0-12&quot; ELSEIF [tenure]&lt;=24 THEN &quot;13-24&quot; ELSEIF [tenure]&lt;=36 THEN &quot;25-36&quot; ELSEIF [tenure]&lt;=48 THEN &quot;37-48&quot; ELSEIF [tenure]&lt;=60 THEN &quot;49-60&quot; ELSE &quot;61-72&quot; END' />
      </column>
      <column caption='Is Highest' datatype='boolean' name='[Calculation_1797209592643593]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1797209592205316] = WINDOW_MAX([Calculation_1797209592205316])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
